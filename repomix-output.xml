:root {
  color-scheme: light;
  --surface: #fcfcfb;
  --surface-2: #f4f3ef;
  --sea: #dde7ea;
  --text-primary: #14130f;
  --text-secondary: #52514e;
  --text-muted: #8a887f;
  --accent: #14684a;
  --accent-hover: #0f533c;
  --accent-ink: #ffffff;
  --accent-soft: rgba(20, 104, 74, 0.08);
  --danger: #b3352c;
  --border: #e3e1d9;
  --shadow: 0 1px 3px rgba(20, 19, 15, 0.08), 0 4px 14px rgba(20, 19, 15, 0.06);
  --pin-ring: #fcfcfb;
}
@media (prefers-color-scheme: dark) {
  :root {
    color-scheme: dark;
    --surface: #1a1a19;
    --surface-2: #232322;
    --sea: #171e20;
    --text-primary: #f4f3ee;
    --text-secondary: #c3c2b7;
    --text-muted: #8b8a80;
    --accent: #2fa87c;
    --accent-ink: #0c1310;
    --accent-soft: rgba(47, 168, 124, 0.14);
    --danger: #e66760;
    --border: #33342f;
    --shadow: 0 1px 3px rgba(0, 0, 0, 0.4), 0 4px 14px rgba(0, 0, 0, 0.3);
    --pin-ring: #1a1a19;
  }
}

* { box-sizing: border-box; }
html, body { height: 100%; margin: 0; }
body {
  background: var(--surface);
  color: var(--text-primary);
  font: 15px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
}
a { color: var(--accent); text-decoration: none; }
a:hover { text-decoration: underline; }

.serif { font-family: Georgia, "Times New Roman", serif; }

.container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }

.site-header {
  border-bottom: 1px solid var(--border);
  padding: 14px 0;
}
.site-header .container { display: flex; align-items: center; gap: 16px; }
.logo { font-family: Georgia, serif; font-size: 20px; font-weight: 700; color: var(--text-primary); }
.logo:hover { text-decoration: none; }
.header-spacer { flex: 1; }

h1 { font-family: Georgia, "Times New Roman", serif; font-weight: 600; }

.btn {
  display: inline-block;
  font: 600 14px/1 inherit;
  font-family: inherit;
  color: var(--text-secondary);
  background: transparent;
  border: 1px solid var(--border);
  border-radius: 999px;
  padding: 9px 18px;
  cursor: pointer;
  text-decoration: none;
}
.btn:hover { background: var(--surface-2); text-decoration: none; }
.btn-primary { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }
.btn-primary:hover { background: var(--accent); filter: brightness(1.08); }
.btn-small { padding: 5px 12px; font-size: 13px; }
.btn-danger { color: var(--danger); }
.btn:disabled { opacity: 0.5; cursor: default; }
.btn-icon {
  border: 1px solid var(--border);
  background: transparent;
  color: var(--text-secondary);
  border-radius: 7px;
  width: 26px; height: 26px;
  cursor: pointer;
  font-size: 13px;
  line-height: 1;
}
.btn-icon:hover { background: var(--surface-2); }
.btn-icon:disabled { opacity: 0.35; cursor: default; }

.input, textarea.input, select.input {
  font: 14px/1.4 inherit;
  font-family: inherit;
  color: var(--text-primary);
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 9px;
  padding: 9px 12px;
  width: 100%;
}
.input:focus { outline: 2px solid var(--accent-soft); border-color: var(--accent); }
label.field { display: block; font-size: 13px; color: var(--text-secondary); font-weight: 600; margin-bottom: 4px; }

.card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 20px;
  box-shadow: var(--shadow);
}

.chip {
  font-size: 12.5px;
  color: var(--text-secondary);
  background: var(--surface-2);
  border: 1px solid var(--border);
  border-radius: 999px;
  padding: 3px 11px;
  white-space: nowrap;
}
.chip-score { color: var(--accent); font-weight: 700; }

.muted { color: var(--text-muted); }
.small { font-size: 13px; }
.error-text { color: var(--danger); font-size: 13.5px; }
.success-text { color: var(--accent); font-size: 13.5px; }

/* ranked list rows */
.rank-badge {
  flex: none;
  width: 30px; height: 30px;
  border-radius: 50%;
  background: var(--accent);
  color: var(--accent-ink);
  font-size: 13.5px;
  font-weight: 700;
  display: flex; align-items: center; justify-content: center;
}
.course-row {
  display: flex;
  gap: 14px;
  align-items: flex-start;
  padding: 12px 16px;
  border-left: 3px solid transparent;
  border-bottom: 1px solid var(--border);
}
.course-row.clickable { cursor: pointer; }
.course-row.clickable:hover { background: var(--surface-2); }
.course-row.active { background: var(--accent-soft); border-left-color: var(--accent); }
.course-main { flex: 1; min-width: 0; }
.course-name { font-weight: 600; font-size: 15px; }
.course-loc { color: var(--text-secondary); font-size: 13px; }
.course-note { color: var(--text-muted); font-size: 13px; font-style: italic; margin-top: 3px; }

/* rounds */
.round-row {
  display: flex; gap: 12px; align-items: baseline; flex-wrap: wrap;
  padding: 8px 0; border-top: 1px dashed var(--border);
  font-size: 13.5px;
}
.round-score { font-weight: 700; color: var(--accent); font-size: 15px; }
.scorecard-thumb {
  display: block;
  max-width: 260px; max-height: 170px;
  border-radius: 8px; border: 1px solid var(--border);
  object-fit: cover; cursor: zoom-in;
}
.scorecard-full { max-width: 100%; border-radius: 10px; border: 1px solid var(--border); }

/* map pins (leaflet divIcon) */
.pin { background: transparent; border: none; }
.pin span {
  display: flex;
  width: 26px; height: 26px;
  border-radius: 50% 50% 50% 4px;
  transform: rotate(-45deg);
  background: var(--accent);
  border: 2px solid var(--pin-ring);
  box-shadow: var(--shadow);
  align-items: center; justify-content: center;
}
.pin span i {
  transform: rotate(45deg);
  font-style: normal;
  color: var(--accent-ink);
  font-size: 11.5px;
  font-weight: 700;
}
.pin.hl span { background: var(--text-primary); }
.pin.hl span i { color: var(--surface); }

.leaflet-container { font: inherit; background: var(--sea); border-radius: 14px; }
.leaflet-popup-content-wrapper, .leaflet-popup-tip {
  background: var(--surface); color: var(--text-primary);
  box-shadow: var(--shadow); border-radius: 10px;
}
.popup-rank { color: var(--accent); font-weight: 700; font-size: 12.5px; letter-spacing: 0.4px; }
.popup-name { font-weight: 600; font-size: 15px; }
.popup-loc { color: var(--text-secondary); font-size: 13px; }
@media (prefers-color-scheme: dark) {
  .leaflet-layer { filter: brightness(0.85) contrast(0.95); }
  .leaflet-control-attribution { background: rgba(26, 26, 25, 0.7); color: var(--text-muted); }
}

/* two-pane public layout */
.list-layout { display: flex; gap: 20px; align-items: flex-start; }
.list-map { flex: 1.25; position: sticky; top: 16px; min-width: 0; }
.list-pane { flex: 1; min-width: 340px; }
@media (max-width: 880px) {
  .list-layout { flex-direction: column; }
  .list-map { position: static; width: 100%; }
  .list-pane { min-width: 0; width: 100%; }
}

.footer-note {
  border-top: 1px solid var(--border);
  margin-top: 40px; padding: 16px 0 28px;
  color: var(--text-muted); font-size: 12.5px;
}

/* ---------- mobile optimization ---------- */

.action-bar { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; margin-bottom: 8px; }
.action-strip { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 16px; }
.form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.round-form { display: flex; gap: 8px; flex-wrap: wrap; align-items: flex-end; margin-top: 10px; }
.rowlink { cursor: pointer; font-size: 12px; }

@media (max-width: 820px) {
  /* 16px inputs stop iOS Safari's auto-zoom on focus */
  .input, textarea.input, select.input { font-size: 16px; }

  /* header: title stays put, buttons become a swipeable strip */
  .action-strip {
    flex-wrap: nowrap;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding-bottom: 4px;
    margin-left: -24px; margin-right: -24px;
    padding-left: 24px; padding-right: 24px;
  }
  .action-strip::-webkit-scrollbar { display: none; }
  .action-strip .btn { flex: none; }

  /* comfortable tap targets */
  .btn { padding: 10px 16px; }
  .btn-small { padding: 9px 14px; font-size: 14px; }
  .btn-icon { width: 36px; height: 36px; font-size: 16px; border-radius: 9px; }
  .rowlink { font-size: 14px; padding: 6px 2px; display: inline-block; }

  /* map takes ~38% of screen so the list is one flick away */
  .edit-map-wrap > div:first-child { height: 38vh !important; }

  /* forms stack full-width */
  .form-grid { grid-template-columns: 1fr; }
  .round-form > div { width: 100% !important; flex: 1 1 100% !important; }
  .round-form button { width: 100%; padding: 12px; }

  .course-row { padding: 12px 12px; gap: 10px; }
  h1 { font-size: 24px; }
}
</file>

